<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link href="https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.css" rel="stylesheet" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.3.0/flowbite.min.js"></script>
  <link href="/css/output.css" rel="stylesheet">
  <title>
    <%= title %>
  </title>
</head>

<body class="min-h-screen w-full bg-white flex items-center justify-center">

  <div class="min-h-screen w-full bg-gray-50">

    <header class="bg-white border-b size-full border-gray-200 px-6 py-4">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-xl font-bold text-gray-800">Trackmaatje</h1>
          <p class="text-sm text-gray-500">Macrotracker</p>
        </div>
        <div class="flex items-center gap-2">

          <a href="/foodplan" class="p-1 w-30 hover:bg-gray-100 text-center rounded-lg transition-colors">
            <span class="w-5 h-5 text-black-600">Foodplan

            </span>
          </a>
          <a href="/achievements" class="p-1 w-30 hover:bg-gray-100 text-center rounded-lg transition-colors">
            <span class="w-5 h-5 text-black-600">Achievements
            </span>
          </a>
          <button action="/logout" class="p-1 w-30 hover:bg-gray-100 text-center rounded-lg transition-colors">
            <span class="w-5 h-5 text-black-600">Logout

            </span>
          </button>
          <div class="p-2 w-30 text-center rounded-lg transition-colors">
            <%= firstname %>
          </div>
        </div>
      </div>
    </header>


    <main class="max-w-7xl mx-auto px-6 py-8">
      <% if (!plan) { %>
        <div class="text-center py-16">
          <h2 class="text-2xl font-semibold text-gray-800 mb-4">Welcome to Trackmaatje!</h2>
          <p class="text-gray-600 mb-8">It looks like you haven't set up your food plan yet. Click the button below to get started!</p>
        <div class="flex items-center justify-center py-16">
          <a href="/foodplan"
            class="inline-flex items-center justify-center rounded-lg bg-green-600 px-6 py-3 text-white font-semibold hover:bg-green-700 transition-colors">
            Go to Foodplan
          </a>
        </div>
      <% } else { %>
      <div class="space-y-6">

          <div class="flex items-center justify-between mb-8">
            <h2 class="text-2xl font-semibold text-gray-800">Daily Overview</h2>
            <div class="flex items-center gap-4">
              <div class="flex items-center gap-2 bg-white px-4 py-2 rounded-lg border border-gray-200">
                <span class="text-sm text-gray-600">Streak:</span>
                <span class="font-semibold text-gray-800">69</span>
                <Flame class="w-5 h-5 text-orange-500" />
              </div>
              <button data-modal-target="default-modal" data-modal-toggle="default-modal"
                class=" w-20flex items-center gap-2 bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-green-600 transition-colors">
                <Plus class="w-5 h-5" />
                Add Food
              </button>
            </div>
          </div>

          <div id="default-modal" tabindex="-1" aria-hidden="true"
            class="hidden overflow-y-auto overflow-x-hidden fixed inset-0 z-50 flex justify-center items-center w-full h-full bg-black/30">
            <div class="relative p-4 w-full max-w-xl">
              <div class="relative bg-white border border-gray-200 rounded-lg shadow-lg p-6">

                <!-- Header -->
                <div class="flex justify-between items-start pb-4">
                  <div>
                    <h3 class="text-xl font-semibold text-gray-800">Add food item</h3>
                    <p class="text-gray-500 text-sm mt-1">Enter the nutritional information for your food item</p>
                  </div>

                  <button type="button"
                    class="text-gray-500 hover:bg-gray-100 rounded-lg w-9 h-9 flex items-center justify-center"
                    data-modal-hide="default-modal">
                    <svg class="w-5 h-5" aria-hidden="true" fill="none" viewBox="0 0 24 24">
                      <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M6 18 17.94 6M18 18 6.06 6" />
                    </svg>
                  </button>
                </div>

                <!-- Body -->


                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <form action="/addfood" method="post">
                      <label class="block text-sm font-medium mb-1 text-gray-700">Food name</label>
                      <input type="text" name="foodItem"
                        class="w-full px-3 py-2.5 bg-gray-100 border border-gray-300 rounded-lg text-sm"
                        placeholder="Chicken breast" />
                  </div>

                  <div>
                    <label class="block text-sm font-medium mb-1 text-gray-700">Amount (in grams)</label>
                    <input type="number" name="amount"
                      class="w-full px-3 py-2.5 bg-gray-100 border border-gray-300 rounded-lg text-sm"
                      placeholder="eg. 300g" />
                  </div>
                </div>

                <div>
                  <select name="type"
                    class="block w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-lg text-sm text-gray-700">
                    <option disabled selected>Select meal</option>
                    <option value="breakfast">Breakfast</option>
                    <option value="lunch">Lunch</option>
                    <option value="dinner">Dinner</option>
                    <option value="snack">Snack</option>
                  </select>
                </div>

                <div class="grid grid-cols-3 gap-4">
                  <div>
                    <label class="block text-sm font-medium mb-1 text-gray-700">Protein (g)</label>
                    <input type="number" name="protein"
                      class="w-full px-3 py-2.5 bg-gray-100 border border-gray-300 rounded-lg text-sm" value="0" />
                  </div>

                  <div>
                    <label class="block text-sm font-medium mb-1 text-gray-700">Carbs (g)</label>
                    <input type="number" name="carbs"
                      class="w-full px-3 py-2.5 bg-gray-100 border border-gray-300 rounded-lg text-sm" value="0" />
                  </div>

                  <div>
                    <label class="block text-sm font-medium mb-1 text-gray-700">Fats (g)</label>
                    <input type="number" name="fats"
                      class="w-full px-3 py-2.5 bg-gray-100 border border-gray-300 rounded-lg text-sm" value="0" />
                  </div>
                </div>

                <div>
                  <label class="block text-sm font-medium mb-1 text-gray-700">Calories</label>
                  <input type="number" name="calories"
                    class="w-full px-3 py-2.5 bg-gray-100 border border-gray-300 rounded-lg text-sm"
                    placeholder="Calories" />
                </div>
              </div>

              <!-- Footer -->
              <div class="flex justify-end gap-3 pt-6">
                <button data-modal-hide="default-modal"
                  class="px-4 py-2.5 text-sm bg-white border border-gray-300 rounded-lg hover:bg-gray-100">
                  Cancel
                </button>

                <button type="submit" class="px-4 py-2.5 text-sm text-white bg-green-600 rounded-lg hover:bg-green-700">
                  Add food
                </button>
                </form>
              </div>

            </div>
          </div>
      </div>

      <div class="grid grid-cols-4 gap-4 mb-8">

        <div class="bg-white rounded-lg border border-gray-200 p-4">
          <div class="flex items-center justify-between mb-3">
            <span class="text-sm text-gray-600">Calories</span>
          </div>




          <% if (plan) { %>
            <div class="mb-2">
              <span class="text-2xl font-bold text-gray-800">
                <%= plan.calories %>
              </span>
              <span class="text-gray-500"> / <%= plan.calories %> kcal</span>
            </div>

            <% let calPercent=Math.round((0 / plan.calories) * 100); %>

              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-orange-400 h-2 rounded-full" style="width: <%= calPercent %>%"></div>
              </div>
              <span class="text-xs text-gray-500">
                <%= calPercent %>% of daily goal
              </span>
              <% } else { %>
                <p class="text-gray-500">No plan yet</p>
                <% } %>
        </div>

        <div class="bg-white rounded-lg border border-gray-200 p-4">
          <div class="flex items-center justify-between mb-3">
            <span class="text-sm text-gray-600">Protein</span>
          </div>

          <% if (plan) { %>
            <div class="mb-2">
              <span class="text-2xl font-bold text-gray-800">
                <%= plan.proteins %>
              </span>
              <span class="text-gray-500"> / <%= plan.proteins %> g</span>
            </div>

            <% let proteinPercent=Math.round((0 / plan.proteins) * 100); %>

              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-red-400 h-2 rounded-full" style="width: <%= proteinPercent %>%"></div>
              </div>
              <span class="text-xs text-gray-500">
                <%= proteinPercent %>% of daily goal
              </span>
              <% } else { %>
                <p class="text-gray-500">No plan yet</p>
                <% } %>
        </div>

        <div class="bg-white rounded-lg border border-gray-200 p-4">
          <div class="flex items-center justify-between mb-3">
            <span class="text-sm text-gray-600">Carbs</span>

          </div>

          <% if (plan) { %>
            <div class="mb-2">
              <span class="text-2xl font-bold text-gray-800">
                <%= plan.carbs %>
              </span>
              <span class="text-gray-500"> / <%= plan.carbs %> g</span>
            </div>

            <% let carbPercent=Math.round((0 / plan.carbs) * 100); %>

              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-yellow-500 h-2 rounded-full" style="width: <%= carbPercent %>%"></div>
              </div>
              <span class="text-xs text-gray-500">
                <%= carbPercent %>% of daily goal
              </span>
              <% } else { %>
                <p class="text-gray-500">No plan yet</p>
                <% } %>
        </div>


        <div class="bg-white rounded-lg border border-gray-200 p-4">
          <div class="flex items-center justify-between mb-3">
            <span class="text-sm text-gray-600">Fats</span>

          </div>

          <% if (plan) { %>
            <div class="mb-2">
              <span class="text-2xl font-bold text-gray-800">
                <%= plan.fats %>
              </span>
              <span class="text-gray-500"> / <%= plan.fats %> g</span>
            </div>

            <% let fatPercent=Math.round((0 / plan.fats) * 100); %>

              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-cyan-400 h-2 rounded-full" style="width: <%= fatPercent %>%"></div>
              </div>
              <span class="text-xs text-gray-500">
                <%= fatPercent %>% of daily goal
              </span>
              <% } else { %>
                <p class="text-gray-500">No plan yet</p>
                <% } %>
        </div>

      </div>


      <div class="bg-white rounded-lg border border-gray-200 mb-4">
        <div class="border-b border-gray-200 px-6 py-4">
          <h3 class="text-lg font-semibold text-gray-800">Breakfast</h3>
        </div>
        <div class="px-6 py-4">
          <table class="w-full">
            <thead>
              <tr class="text-left text-sm text-gray-600 border-b border-gray-200">
                <th class="pb-3 font-medium">Food</th>
                <th class="pb-3 font-medium text-right">Protein (g)</th>
                <th class="pb-3 font-medium text-right">Carbs (g)</th>
                <th class="pb-3 font-medium text-right">Fats (g)</th>
                <th class="pb-3 font-medium text-right">Calories</th>
                <th class="pb-3 w-12"></th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-gray-100">
                <td class="py-4 text-gray-800">Greek Yogurt</td>
                <td class="py-4 text-right text-gray-800">17</td>
                <td class="py-4 text-right text-gray-800">9</td>
                <td class="py-4 text-right text-gray-800">5</td>
                <td class="py-4 text-right text-gray-800">150</td>
                <td class="py-4 text-right">
                  <button class="p-1 hover:bg-gray-100 rounded">
                    <span class="text-gray-400">⋮</span>
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="bg-white rounded-lg border border-gray-200">
        <div class="border-b border-gray-200 px-6 py-4">
          <h3 class="text-lg font-semibold text-gray-800">Lunch</h3>
        </div>
        <div class="px-6 py-4">
          <table class="w-full">
            <thead>
              <tr class="text-left text-sm text-gray-600 border-b border-gray-200">
                <th class="pb-3 font-medium">Food</th>
                <th class="pb-3 font-medium text-right">Protein (g)</th>
                <th class="pb-3 font-medium text-right">Carbs (g)</th>
                <th class="pb-3 font-medium text-right">Fats (g)</th>
                <th class="pb-3 font-medium text-right">Calories</th>
                <th class="pb-3 w-12"></th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-gray-100">
                <td class="py-4 text-gray-800">Grilled Chicken Breast</td>
                <td class="py-4 text-right text-gray-800">31</td>
                <td class="py-4 text-right text-gray-800">0</td>
                <td class="py-4 text-right text-gray-800">3.6</td>
                <td class="py-4 text-right text-gray-800">165</td>
                <td class="py-4 text-right">
                  <button class="p-1 hover:bg-gray-100 rounded">
                    <span class="text-gray-400">⋮</span>
                  </button>
                </td>
              </tr>
              <tr class="border-b border-gray-100">
                <td class="py-4 text-gray-800">Brown Rice</td>
                <td class="py-4 text-right text-gray-800">5</td>
                <td class="py-4 text-right text-gray-800">45</td>
                <td class="py-4 text-right text-gray-800">1.6</td>
                <td class="py-4 text-right text-gray-800">216</td>
                <td class="py-4 text-right">
                  <button class="p-1 hover:bg-gray-100 rounded">
                    <span class="text-gray-400">⋮</span>
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      <% } %>
    </main>
  </div>
</body>

</html>