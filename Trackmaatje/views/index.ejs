          <a href="/login" class="p-2 w-30 hover:bg-gray-100 hover:border-2 border-gray-200  rounded-lg transition-colors">
            <span class="w-5 h-5 text-black-600">Logout
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10.6667 11.3334L14.0001 8.00008L10.6667 4.66675" stroke="#0A0A0A" stroke-width="1.33333"
                  stroke-linecap="round" stroke-linejoin="round" />
