<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="/css/output.css" rel="stylesheet">
  <link rel="icon" type="image/png" href="/images/logo.png">
  <title>
    <%= title %>
  </title>
</head>

<body class="min-h-screen bg-white flex items-center justify-center">

  <div class="min-h-screen bg-gray-50">

    <header class="bg-white border-b size-full border-gray-200 px-6 py-4">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-xl font-bold text-gray-800">Trackmaatje</h1>
          <p class="text-sm text-gray-500">Macrotracker</p>
        </div>
        <div class="flex items-center gap-4">

          <a href="/foodplan" class="p-2 w-30 hover:bg-gray-100 text-center rounded-lg transition-colors">
            <span class="w-5 h-5 text-black-600">Foodplan
              
            </span>
          </a>
          <a href="/achievements" class="p-2 w-30 hover:bg-gray-100 text-center rounded-lg transition-colors">
            <span class="w-5 h-5 text-black-600">Achievements
            </span>
          </a>
          <button action="/logout"
            class="p-2 w-30 hover:bg-gray-100 text-center rounded-lg transition-colors">
            <span class="w-5 h-5 text-black-600">Logout
              
            </span>
          </button>
          <div class="p-2 w-30 text-center rounded-lg transition-colors"><%= firstname %></div>
        </div>
      </div>
    </header>


    <main class="max-w-7xl mx-auto px-6 py-8">

      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-semibold text-gray-800">Daily Overview</h2>
        <div class="flex items-center gap-4">
          <div class="flex items-center gap-2 bg-white px-4 py-2 rounded-lg border border-gray-200">
            <span class="text-sm text-gray-600">Streak:</span>
            <span class="font-semibold text-gray-800">69</span>
            <Flame class="w-5 h-5 text-orange-500" />
          </div>
          <button
            class=" w-20flex items-center gap-2 bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-green-600 transition-colors">
            <Plus class="w-5 h-5" />
            Add Food
          </button>
        </div>
      </div>


      <div class="grid grid-cols-4 gap-4 mb-8">

                <div class="bg-white rounded-lg border border-gray-200 p-4">
          <div class="flex items-center justify-between mb-3">
            <span class="text-sm text-gray-600">Calories</span>
          </div>

          <% if (plan) { %>
            <div class="mb-2">
              <span class="text-2xl font-bold text-gray-800">
                <%= plan.calories %>
              </span>
              <span class="text-gray-500"> / <%= plan.calories %> kcal</span>
            </div>

            <% let calPercent=Math.round((0 / plan.calories) * 100); %>

              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-orange-400 h-2 rounded-full" style="width: <%= calPercent %>%"></div>
              </div>
              <span class="text-xs text-gray-500">
                <%= calPercent %>% of daily goal
              </span>
              <% } else { %>
                <p class="text-gray-500">No plan yet</p>
                <% } %>
        </div>

        <div class="bg-white rounded-lg border border-gray-200 p-4">
          <div class="flex items-center justify-between mb-3">
            <span class="text-sm text-gray-600">Protein</span>
          </div>

          <% if (plan) { %>
            <div class="mb-2">
              <span class="text-2xl font-bold text-gray-800">
                <%= plan.proteins %>
              </span>
              <span class="text-gray-500"> / <%= plan.proteins %> g</span>
            </div>

            <% let proteinPercent=Math.round((0 / plan.proteins) * 100); %>

              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-red-400 h-2 rounded-full" style="width: <%= proteinPercent %>%"></div>
              </div>
              <span class="text-xs text-gray-500">
                <%= proteinPercent %>% of daily goal
              </span>
              <% } else { %>
                <p class="text-gray-500">No plan yet</p>
                <% } %>
        </div>

        <div class="bg-white rounded-lg border border-gray-200 p-4">
          <div class="flex items-center justify-between mb-3">
            <span class="text-sm text-gray-600">Carbs</span>

          </div>

          <% if (plan) { %>
            <div class="mb-2">
              <span class="text-2xl font-bold text-gray-800">
                <%= plan.carbs %>
              </span>
              <span class="text-gray-500"> / <%= plan.carbs %> g</span>
            </div>

            <% let carbPercent=Math.round((0 / plan.carbs) * 100); %>

              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-yellow-500 h-2 rounded-full" style="width: <%= carbPercent %>%"></div>
              </div>
              <span class="text-xs text-gray-500">
                <%= carbPercent %>% of daily goal
              </span>
              <% } else { %>
                <p class="text-gray-500">No plan yet</p>
                <% } %>
        </div>


        <div class="bg-white rounded-lg border border-gray-200 p-4">
          <div class="flex items-center justify-between mb-3">
            <span class="text-sm text-gray-600">Fats</span>

          </div>

          <% if (plan) { %>
            <div class="mb-2">
              <span class="text-2xl font-bold text-gray-800">
                <%= plan.fats %>
              </span>
              <span class="text-gray-500"> / <%= plan.fats %> g</span>
            </div>

            <% let fatPercent=Math.round((0 / plan.fats) * 100); %>

              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-cyan-400 h-2 rounded-full" style="width: <%= fatPercent %>%"></div>
              </div>
              <span class="text-xs text-gray-500">
                <%= fatPercent %>% of daily goal
              </span>
              <% } else { %>
                <p class="text-gray-500">No plan yet</p>
                <% } %>
        </div>

      </div>


      <div class="bg-white rounded-lg border border-gray-200 mb-4">
        <div class="border-b border-gray-200 px-6 py-4">
          <h3 class="text-lg font-semibold text-gray-800">Breakfast</h3>
        </div>
        <div class="px-6 py-4">
          <table class="w-full">
            <thead>
              <tr class="text-left text-sm text-gray-600 border-b border-gray-200">
                <th class="pb-3 font-medium">Food</th>
                <th class="pb-3 font-medium text-right">Protein (g)</th>
                <th class="pb-3 font-medium text-right">Carbs (g)</th>
                <th class="pb-3 font-medium text-right">Fats (g)</th>
                <th class="pb-3 font-medium text-right">Calories</th>
                <th class="pb-3 w-12"></th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-gray-100">
                <td class="py-4 text-gray-800">Greek Yogurt</td>
                <td class="py-4 text-right text-gray-800">17</td>
                <td class="py-4 text-right text-gray-800">9</td>
                <td class="py-4 text-right text-gray-800">5</td>
                <td class="py-4 text-right text-gray-800">150</td>
                <td class="py-4 text-right">
                  <button class="p-1 hover:bg-gray-100 rounded">
                    <span class="text-gray-400">⋮</span>
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="bg-white rounded-lg border border-gray-200">
        <div class="border-b border-gray-200 px-6 py-4">
          <h3 class="text-lg font-semibold text-gray-800">Lunch</h3>
        </div>
        <div class="px-6 py-4">
          <table class="w-full">
            <thead>
              <tr class="text-left text-sm text-gray-600 border-b border-gray-200">
                <th class="pb-3 font-medium">Food</th>
                <th class="pb-3 font-medium text-right">Protein (g)</th>
                <th class="pb-3 font-medium text-right">Carbs (g)</th>
                <th class="pb-3 font-medium text-right">Fats (g)</th>
                <th class="pb-3 font-medium text-right">Calories</th>
                <th class="pb-3 w-12"></th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-gray-100">
                <td class="py-4 text-gray-800">Grilled Chicken Breast</td>
                <td class="py-4 text-right text-gray-800">31</td>
                <td class="py-4 text-right text-gray-800">0</td>
                <td class="py-4 text-right text-gray-800">3.6</td>
                <td class="py-4 text-right text-gray-800">165</td>
                <td class="py-4 text-right">
                  <button class="p-1 hover:bg-gray-100 rounded">
                    <span class="text-gray-400">⋮</span>
                  </button>
                </td>
              </tr>
              <tr class="border-b border-gray-100">
                <td class="py-4 text-gray-800">Brown Rice</td>
                <td class="py-4 text-right text-gray-800">5</td>
                <td class="py-4 text-right text-gray-800">45</td>
                <td class="py-4 text-right text-gray-800">1.6</td>
                <td class="py-4 text-right text-gray-800">216</td>
                <td class="py-4 text-right">
                  <button class="p-1 hover:bg-gray-100 rounded">
                    <span class="text-gray-400">⋮</span>
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</body>

</html>